{
  "name": "jimaku",
  "version": "0.8.3",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @jimaku/extension run build",
    "build:release": "pnpm --filter @jimaku/extension run build:release",
    "test": "pnpm -r run test",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/extension",
    "bench": "pnpm --filter @jimaku/core run bench",
    "icons": "for size in 16 32 48 128; do rsvg-convert -w $size -h $size assets/icon.svg -o packages/extension/public/icons/icon-$size.png; done"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
